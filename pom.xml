<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.MintNiu</groupId>
    <artifactId>queryx</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <packaging>pom</packaging>

    <name>QueryX</name>

    <description>Annotation-driven query enhancement framework for MyBatis Plus.</description>

    <modules>
        <module>queryx-core</module>
        <module>queryx-spring-boot-autoconfigure</module>
        <module>queryx-spring-boot-starter</module>
        <module>queryx-example</module>
    </modules>

    <properties>

        <java.version>17</java.version>

        <spring.boot.version>3.2.5</spring.boot.version>

        <mybatis-plus.version>3.5.5</mybatis-plus.version>

        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>

        <dependencies>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 强制使用兼容的 MyBatis 版本 -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis-spring</artifactId>
                <version>3.0.3</version>
            </dependency>

        </dependencies>

    </dependencyManagement>

</project>
